{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold_annotation.schema.json",
  "title": "Ground truth for one benchmark drawing (requirement L01)",
  "description": "Annotated by a competent person, not by the reader. Same classes, coordinates and ids conventions as pid_extraction. 'split' is fixed when the drawing enters the gold set and never changed afterwards; 'test' drawings are never used for tuning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gold_version", "drawing_id", "split", "provenance", "style", "pages", "objects", "connections", "markups"],
  "properties": {
    "gold_version": {"const": 1},
    "drawing_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["development", "test"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["origin", "clearance", "annotator", "annotated_utc"],
                   "properties": {"origin": {"enum": ["SYNTHETIC", "OWNER_CLEARED"]}, "clearance": {"type": "string", "description": "Where the written clearance or generator record is kept."}, "annotator": {"type": "string"}, "annotated_utc": {"type": "string"}}},
    "style": {"type": "object", "additionalProperties": false, "required": ["source_kind", "density", "symbol_style"],
              "properties": {"source_kind": {"enum": ["VECTOR_CLEAN", "VECTOR_DENSE", "SCANNED", "MIXED"]}, "density": {"enum": ["LOW", "MEDIUM", "HIGH"]}, "symbol_style": {"type": "string"}, "multi_sheet": {"type": "boolean"}}},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["page", "classification"], "properties": {"page": {"type": "integer", "minimum": 1}, "classification": {"enum": ["VECTOR_TEXT", "RASTER_ONLY", "MIXED", "NOT_PID"]}}}},
    "objects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gold_id", "class", "page", "bbox", "text"],
                                          "properties": {"gold_id": {"type": "string"}, "class": {"type": "string"}, "page": {"type": "integer", "minimum": 1}, "bbox": {"type": "object", "required": ["x0", "y0", "x1", "y1"]}, "text": {"type": "string"}, "loop_id": {"type": "string"}}}},
    "connections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from_gold_id", "to_gold_id", "type"],
                                              "properties": {"from_gold_id": {"type": "string"}, "to_gold_id": {"type": "string"}, "type": {"type": "string"}, "direction": {"enum": ["FORWARD", "BACKWARD", "UNKNOWN"]}}}},
    "markups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["page", "bbox", "kind"], "properties": {"page": {"type": "integer"}, "bbox": {"type": "object"}, "kind": {"enum": ["REVISION_CLOUD", "REDLINE", "HANDWRITING", "STAMP", "OTHER"]}}}}
  }
}
