{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pid_extraction.schema.json",
  "title": "P&ID reader output (schema_version 1)",
  "description": "Everything the reader proposes from one document revision. Every item is a PROPOSAL and UNVERIFIED. Coordinates are normalised to the page: origin top-left, 0..1, x0<x1, y0<y1 (the same convention as the host's drawing_region). Text printed on the drawing is quoted verbatim in 'text' and 'evidence'; numbers with units are kept as strings and never converted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "document", "pages", "objects", "connections", "loop_proposals", "shared_component_evidence", "unreadable_regions", "warnings", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "provenance": {"$ref": "#/$defs/provenance"},
    "document": {"$ref": "#/$defs/document"},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "loop_proposals": {"type": "array", "items": {"$ref": "#/$defs/loop_proposal"}},
    "shared_component_evidence": {"type": "array", "items": {"$ref": "#/$defs/shared_component"}},
    "unreadable_regions": {"type": "array", "items": {"$ref": "#/$defs/unreadable"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "unit_interval": {"type": "number", "minimum": 0, "maximum": 1},
    "bbox": {
      "type": "object", "additionalProperties": false, "required": ["x0", "y0", "x1", "y1"],
      "properties": {"x0": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}, "y0": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
                     "x1": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "y1": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
    },
    "status": {"const": "UNVERIFIED"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["module_name", "module_version", "schema_version", "params", "params_sha256", "input_sha256", "models", "run_id", "started_utc", "finished_utc", "host", "limitations_text", "reader_confidence_note", "result_sha256"],
      "properties": {
        "module_name": {"const": "pid_reader"},
        "module_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"},
        "schema_version": {"const": 1},
        "params": {"type": "object"},
        "params_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "models": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "sha256", "licence"], "properties": {"id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "licence": {"type": "string"}}}},
        "run_id": {"type": "string", "minLength": 1},
        "started_utc": {"$ref": "#/$defs/utc"},
        "finished_utc": {"$ref": "#/$defs/utc"},
        "host": {"type": "object", "additionalProperties": false, "required": ["os", "python"], "properties": {"os": {"type": "string"}, "python": {"type": "string"}}},
        "limitations_text": {"type": "string", "minLength": 20, "maxLength": 4000},
        "reader_confidence_note": {"type": "string", "minLength": 10},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false, "required": ["document_revision_id", "sha256", "filename", "page_count"],
      "properties": {
        "document_revision_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "filename": {"type": "string", "minLength": 1},
        "page_count": {"type": "integer", "minimum": 1, "maximum": 500},
        "title_block": {"type": "object", "additionalProperties": false,
                        "properties": {"drawing_number": {"type": "string"}, "revision": {"type": "string"}, "date": {"type": "string"}, "sheet": {"type": "string"}, "sheets_total": {"type": "string"}, "title": {"type": "string"}, "units": {"type": "string"}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["page", "classification", "reason", "rotation", "read_status"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "classification": {"enum": ["VECTOR_TEXT", "RASTER_ONLY", "MIXED", "NOT_PID"]},
        "reason": {"type": "string", "minLength": 1},
        "rotation": {"enum": [0, 90, 180, 270]},
        "read_status": {"enum": ["READ", "REFUSED"]},
        "refusal_code": {"type": "string"}
      },
      "if": {"properties": {"read_status": {"const": "REFUSED"}}}, "then": {"required": ["refusal_code"]}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["page", "bbox", "text"],
      "properties": {"page": {"type": "integer", "minimum": 1}, "bbox": {"$ref": "#/$defs/bbox"}, "text": {"type": "string", "maxLength": 500}, "span_id": {"type": "string"}}
    },
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "class", "page", "bbox", "text", "parsed", "confidence", "status", "evidence", "attributes"],
      "properties": {
        "id": {"type": "string", "pattern": "^obj-[0-9a-f]{16}$"},
        "class": {"enum": ["VESSEL", "TANK", "COLUMN", "HEAT_EXCHANGER", "PUMP", "COMPRESSOR", "FILTER", "VALVE_MANUAL", "VALVE_CONTROL", "VALVE_ONOFF", "VALVE_CHECK", "PSV", "RUPTURE_DISC", "INSTRUMENT", "LOGIC_SOLVER_NODE", "LINE", "SIGNAL_LINE", "NOZZLE", "OFF_PAGE_CONNECTOR", "SPEC_BREAK", "NOTE", "OTHER", "UNKNOWN"]},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "text": {"type": "string", "description": "As printed, verbatim. May be empty for a symbol without text."},
        "parsed": {"type": "object", "additionalProperties": false, "required": ["parse_status"],
                   "properties": {"parse_status": {"enum": ["PARSED", "PARTIAL", "UNPARSED"]}, "measured_variable": {"type": "string"}, "function_letters": {"type": "string"}, "loop_number": {"type": "string"}, "suffix": {"type": "string"}, "normalised_tag": {"type": "string", "description": "Advisory only; the host applies its own matching rule."}}},
        "confidence": {"$ref": "#/$defs/unit_interval"},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "attributes": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Verbatim strings (size, rating, set pressure as printed, line number, spec). Never converted, never evaluated."}
      }
    },
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["object_id"], "properties": {"object_id": {"type": "string"}, "port": {"type": "string"}}},
    "connection": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "from", "to", "direction", "polyline", "confidence", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^con-[0-9a-f]{16}$"},
        "type": {"enum": ["PROCESS_LINE", "SIGNAL_ELECTRIC", "SIGNAL_PNEUMATIC", "SIGNAL_SOFTWARE", "SIGNAL_CAPILLARY", "MECHANICAL", "UNKNOWN"]},
        "from": {"$ref": "#/$defs/endpoint"}, "to": {"$ref": "#/$defs/endpoint"},
        "direction": {"enum": ["FORWARD", "BACKWARD", "UNKNOWN"], "description": "FORWARD = from to to, only when an arrow is found."},
        "polyline": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}},
        "confidence": {"$ref": "#/$defs/unit_interval"},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "loop_proposal": {
      "type": "object", "additionalProperties": false, "required": ["id", "members", "basis", "confidence", "status", "independence_statement"],
      "properties": {
        "id": {"type": "string", "pattern": "^loop-[0-9a-f]{16}$"},
        "members": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["object_id", "role"], "properties": {"object_id": {"type": "string"}, "role": {"enum": ["SENSOR", "LOGIC_SOLVER", "FINAL_ELEMENT", "OTHER"]}}}},
        "basis": {"type": "string", "minLength": 10},
        "confidence": {"$ref": "#/$defs/unit_interval"},
        "status": {"$ref": "#/$defs/status"},
        "independence_statement": {"const": "Not an assessment of independence."}
      }
    },
    "shared_component": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "object_ids", "basis", "status", "absence_statement"],
      "properties": {
        "id": {"type": "string", "pattern": "^shr-[0-9a-f]{16}$"},
        "kind": {"enum": ["TRANSMITTER", "LOGIC_SOLVER", "FINAL_ELEMENT", "UTILITY", "SIGNAL_PATH"]},
        "object_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "basis": {"type": "string", "minLength": 10},
        "status": {"$ref": "#/$defs/status"},
        "absence_statement": {"const": "The absence of shared-component evidence is not evidence of independence."}
      }
    },
    "unreadable": {
      "type": "object", "additionalProperties": false, "required": ["id", "page", "bbox", "code", "message"],
      "properties": {"id": {"type": "string"}, "page": {"type": "integer", "minimum": 1}, "bbox": {"$ref": "#/$defs/bbox"}, "code": {"type": "string"}, "message": {"type": "string", "minLength": 5}}
    },
    "warning": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {"code": {"enum": ["OVERLAPPING_TEXT", "BROKEN_LINE", "AMBIGUOUS_SYMBOL", "LOW_CONTRAST", "MARKUP_PRESENT", "NO_TEXT_LAYER", "PAGE_NOT_PID", "DUPLICATE_TAG", "TAG_WITHOUT_OBJECT", "OBJECT_WITHOUT_TAG", "DANGLING_CONNECTION", "LIMIT_REACHED", "OTHER"]}, "page": {"type": "integer", "minimum": 1}, "object_id": {"type": "string"}, "message": {"type": "string", "minLength": 5}}
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["counts_by_class", "object_count", "connection_count"],
      "properties": {"counts_by_class": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "object_count": {"type": "integer", "minimum": 0}, "connection_count": {"type": "integer", "minimum": 0}, "duplicate_tags": {"type": "array", "items": {"type": "string"}}, "tags_without_object": {"type": "integer", "minimum": 0}, "objects_without_tag": {"type": "integer", "minimum": 0}, "dangling_connections": {"type": "integer", "minimum": 0}}
    }
  }
}
