{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"P&ID Reader standalone OCR/native tag association proposals v1",
  "type":"object",
  "required":["schema","algorithm","source_sha256","extraction_sha256","symbol_sha256","ocr_sha256","proposals","limitations","result_sha256"],
  "properties":{
    "schema":{"const":"pid-reader-standalone-text-links-v1"},
    "algorithm":{"const":"source-tag-association-0.1"},
    "source_sha256":{"$ref":"#/$defs/hash"},
    "extraction_sha256":{"$ref":"#/$defs/hash"},
    "symbol_sha256":{"$ref":"#/$defs/hash"},
    "ocr_sha256":{"$ref":"#/$defs/hash"},
    "result_sha256":{"$ref":"#/$defs/hash"},
    "proposals":{"type":"array","maxItems":12000,"items":{
      "type":"object","required":["id","symbol_id","page","bbox","association_state","options","unparsed_ocr_evidence","review_state","limitations"],
      "properties":{
        "id":{"type":"string","pattern":"^text-link-[a-f0-9]{16}$"},"symbol_id":{"type":"string","minLength":1},
        "page":{"type":"integer","minimum":1},"bbox":{"$ref":"#/$defs/box"},
        "association_state":{"enum":["NO_TEXT","ONE_TEXT","MULTIPLE_TEXT_OPTIONS"]},
        "review_state":{"const":"PROPOSED_UNVERIFIED"},"limitations":{"type":"string","minLength":15},
        "options":{"type":"array","maxItems":40,"items":{"type":"object","required":["text_candidate","tag_style","sources"],"properties":{
          "text_candidate":{"type":"string","minLength":1},"tag_style":{"enum":["TAG_PATTERN","OTHER_TEXT"]},
          "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["method","bbox"],"properties":{
            "method":{"enum":["PDF_NATIVE","OCR_TESSERACT"]},"object_id":{"type":"string"},"word_ids":{"type":"array","minItems":1,"items":{"type":"string"}},"bbox":{"$ref":"#/$defs/box"}
          },"additionalProperties":false}}
        },"additionalProperties":false}},
        "unparsed_ocr_evidence":{"type":"array","items":{"type":"object","required":["text","word_ids","bbox"],"properties":{
          "text":{"type":"string"},"word_ids":{"type":"array","minItems":1,"items":{"type":"string"}},"bbox":{"$ref":"#/$defs/box"}
        },"additionalProperties":false}}
      },"additionalProperties":false
    }},
    "limitations":{"type":"string","minLength":10}
  },"$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "box":{"type":"object","required":["x0","y0","x1","y1"],"properties":{
      "x0":{"type":"number","minimum":0,"maximum":1},"y0":{"type":"number","minimum":0,"maximum":1},
      "x1":{"type":"number","minimum":0,"maximum":1},"y1":{"type":"number","minimum":0,"maximum":1}
    },"additionalProperties":false}
  },"additionalProperties":false
}
