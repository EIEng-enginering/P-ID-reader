{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": ["status", "source_sha256", "reviewer", "reviewed_utc", "coverage", "items"],
 "properties": {
  "status": {"enum": ["DRAFT", "APPROVED_REFERENCE", "SYNTHETIC_REFERENCE"]},
